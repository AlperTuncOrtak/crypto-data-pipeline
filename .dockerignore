# DIKKAT: Bu dosya UTF-8 olmali. Onceden UTF-16 idi ve Docker onu hic
# okuyamiyordu ("invalid character NUL"), yani hicbir sey dislanmiyordu:
# build context 1.84GB'a cikiyor ve disk doluyordu.

# Imajin ihtiyaci olan: backend/, src/, shared/, requirements.txt

# --- Frontend: backend imajinda hicbir isi yok (~1GB) ---
frontend/
node_modules/

# --- Python sanal ortamlari: container kendi pip install'ini yapiyor (~1GB) ---
venv/
.venv/
backend/venv/

# --- Git gecmisi (~86MB) ---
.git/
.gitignore

# --- Agent/skill dosyalari, imaja gerek yok ---
skills/
.agents/
.claude/
.gemini/
.impeccable/

# --- Veri ve loglar ---
data_lake/
logs/
*.log
redis_win/

# --- Mobil kabuklar ---
android/
ios/

# --- Derleme artiklari ---
__pycache__/
*.pyc
dist/
test-results/

# --- Sirlar: imaja asla gomulmesin, compose env_file ile veriyor ---
# NOT: yalin ".env" sadece KOK dizindekini eslestirir. backend/.env gibi
# ic ice olanlar icin ** gerekiyor — yoksa sirlar imaj katmanina kopyalanir.
.env
.env.*
**/.env
**/.env.*

# --- OS ---
.DS_Store
